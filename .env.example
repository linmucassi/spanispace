# Copy to .env.local for development. Production values live in the Netlify
# dashboard, Site settings, Environment variables. Every key the code reads is
# listed here so nothing is missing at deploy time.

# --- Supabase, required --------------------------------------------------
# supabase.com > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server only. Used by admin routes and the scraper. Never NEXT_PUBLIC, never
# in the browser bundle. Some server code also reads SUPABASE_URL as an alias.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google sign-in, required for the "Continue with Google" button -------
# console.cloud.google.com > APIs & Services > Credentials > your OAuth 2.0
# Web application client. Reuses the same Client ID already configured for
# Supabase's Google provider -- just add these to it, don't create a new one:
#   Authorized JavaScript origins: https://spanispace.com, http://localhost:3000
# This is the public Client ID, safe to ship in the browser bundle (that's
# what NEXT_PUBLIC is for here). Without it the Google button doesn't render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Gemini, required for the CV audit, CV autofill, and profile builder --
# aistudio.google.com/apikey. Free tier, no billing method required at this
# app's request volume. Without it /api/cv-audit, /api/cv-extract, and
# /api/profile-summary all return 503.
GEMINI_API_KEY=

# --- Transactional email, required for confirmations ---------------------
# resend.com > API Keys. Without these the app still works, applicants and new
# accounts simply get no email. NOTE: Supabase auth confirmation emails are a
# separate setting inside Supabase, not this key. See the SMTP note in the repo.
RESEND_API_KEY=
EMAIL_FROM=Spanispace <apply@spanispace.com>
# Optional, where replies to a confirmation email should land
EMAIL_REPLY_TO=

# --- Job scraper, optional ----------------------------------------------
# The daily job scraper. Without ADZUNA the scraper has no South African source.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
EVENTBRITE_API_KEY=
# Long random string. Guards /api/admin/run-scraper against public calls.
SCRAPER_SECRET=
# Lets /api/admin/run-scraper dispatch the GitHub Actions workflow.
# GITHUB_REPO is owner/name, e.g. linmucassi/spanispace
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
