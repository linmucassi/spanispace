# Supabase (get these from supabase.com > Project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Transactional email (resend.com > API Keys). Set both in the Netlify
# dashboard. Without them the apply flow still works, applicants simply get no
# confirmation email.
RESEND_API_KEY=
EMAIL_FROM=Spanispace <apply@spanispace.com>
# Optional, where replies to a confirmation email should land
EMAIL_REPLY_TO=
